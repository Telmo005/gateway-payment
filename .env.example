# === Base de dados própria do gateway (Supabase próprio, isolado dos apps) ===
# Usa a connection string do "Session pooler" (porta 5432) para migrações
# e a "Transaction pooler" para runtime serverless.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# === PaySuite (vivem SÓ aqui — nunca nos apps) ===
PAYSUITE_API_TOKEN="o-teu-token-paysuite"
PAYSUITE_WEBHOOK_SECRET="o-teu-webhook-secret-paysuite"
PAYSUITE_BASE_URL="https://paysuite.tech/api/v1"

# === URL público deste gateway ===
# É para aqui que o gateway manda o PaySuite entregar o webhook (callback_url).
# Ex.: https://pay.teudominio.com  (ou o URL do deployment Vercel)
PUBLIC_BASE_URL="https://pay.teudominio.com"

# === Segredo para as rotas de cron (reconciliação + retry de fan-out) ===
# Os crons chamam com: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="gera-um-segredo-aleatorio-longo"
